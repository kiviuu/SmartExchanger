<Window x:Class="SmartExchanger.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartExchanger"
        Width="480"
        Height="270"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border Margin="0"
            Padding="0"
            Background="#F5232323"
            BorderBrush="#454545"
            BorderThickness="1"
            CornerRadius="12">

        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="5"
                              Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="220"
                       Height="220"
                       Source="/Assets/Icons/icon.png"
                       Stretch="Uniform"/>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Margin="0,12,0,0"
                               Text="Smart Exchanger"
                               Foreground="White"
                               FontSize="27"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Margin="0,4,0,0"
                               Text="Procedural Texture and Material Editor"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               HorizontalAlignment="Center"/>

                    <TextBlock Margin="0,14,0,0"
                               Text="Created by Bartosz Zięba"
                               Foreground="#CCCCCC"
                               FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding VersionText}"
                               Foreground="#777777"
                               FontSize="10"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
            

            <TextBlock Grid.Row="1"
                       Text="{Binding CopyrightText}"
                       Foreground="#777777"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>