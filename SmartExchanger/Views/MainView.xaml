<Window x:Class="SmartExchanger.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:vm="clr-namespace:SmartExchanger.ViewModels"
        xmlns:nodes="clr-namespace:SmartExchanger.ViewModels.Nodes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:views="clr-namespace:SmartExchanger.Views"
        Title="Smart Exchanger" Height="720" Width="1280"
        ResizeMode="CanResize"
        Background="#1E1E1E"
        Icon="/Assets/Icons/small-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/NodeTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closed">
            <i:InvokeCommandAction Command="{Binding Editor.CleanupGraphicsCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="340"
                              MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <nodify:NodifyEditor DataContext="{Binding Editor}"
                                 x:Name="GraphEditor"
                         ItemsSource="{Binding Nodes}" 
                         Connections="{Binding Connections}"
                         SelectedItems="{Binding SelectedNodes}"
                         CanSelectMultipleItems="True"
                         SelectedConnections="{Binding SelectedConnections}"
                         ConnectionStartedCommand="{Binding StartConnectionCommand}"
                         ConnectionCompletedCommand="{Binding CompleteConnectionCommand}"
                         DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                         MouseMove="OnGraphEditorMouseMove"
                         PreviewMouseRightButtonDown="OnGraphEditorPreviewMouseRightButtonDown"
                         GridCellSize="15"
                         Background="#151515"
                         Tag="{Binding}">
                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Z"
                            Modifiers="Control"
                            Command="{Binding UndoCommand}" />

                    <KeyBinding Key="Y"
                                Modifiers="Control"
                                Command="{Binding RedoCommand}" />

                    <KeyBinding Key="Z"
                                Modifiers="Control+Shift"
                                Command="{Binding RedoCommand}" />
                    
                    <KeyBinding Key="C" 
                                Modifiers="Control"
                                Command="{Binding CopySelectionCommand}" />

                    <KeyBinding Key="X"
                                Modifiers="Control"
                                Command="{Binding CutSelectionCommand}" />

                    <KeyBinding Key="V"
                                Modifiers="Control"
                                Command="{Binding PasteSelectionCommand}" />
                    
                    <KeyBinding Key="Delete"
                                Command="{Binding DeleteSelectionCommand}" />
                    <KeyBinding Key="S"
                                Modifiers="Control"
                                Command="{Binding SaveProjectCommand}" />
                    <KeyBinding Key="S"
                                Modifiers="Control+Shift"
                                Command="{Binding SaveProjectAsCommand}" />
                    <KeyBinding Key="O"
                                Modifiers="Control"
                                Command="{Binding OpenProjectCommand}" />
                </nodify:NodifyEditor.InputBindings>
                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                        <nodify:CircuitConnection Source="{Binding Source.Anchor}" 
                                                  Target="{Binding Target.Anchor}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>


                <nodify:NodifyEditor.ContextMenu>
                    <ContextMenu Opened="OnGraphContextMenuOpened">
                        <MenuItem Header="Open project..."
                                  Command="{Binding OpenProjectCommand}"
                                  InputGestureText="Ctrl+O" />
                        <MenuItem Header="Save project"
                                  Command="{Binding SaveProjectCommand}"
                                  InputGestureText="Ctrl+S" />
                        <MenuItem Header="Save project as..."
                                  Command="{Binding SaveProjectAsCommand}"
                                  InputGestureText="Ctrl+Shift+S" />

                        <Separator />

                        <MenuItem Header="{Binding UndoMenuHeader}"
                                  Command="{Binding UndoCommand}"
                                  InputGestureText="Ctrl+Z" />

                        <MenuItem Header="{Binding RedoMenuHeader}"
                                  Command="{Binding RedoCommand}"
                                  InputGestureText="Ctrl+Y" />

                        <Separator />

                        <MenuItem Header="Copy"
                                  Command="{Binding CopySelectionCommand}"
                                  InputGestureText="Ctrl+C" />

                        <MenuItem Header="Cut"
                                  Command="{Binding CutSelectionCommand}"
                                  InputGestureText="Ctrl+X" />

                        <MenuItem Header="Paste"
                                  Command="{Binding PasteSelectionCommand}"
                                  InputGestureText="Ctrl+V" />

                        <Separator />

                        <Separator />
                        <MenuItem Header="Create Node">
                            <MenuItem Header="Start Nodes">
                                <MenuItem Header="Color"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.ColorNode}"/>
                                <MenuItem Header="Value"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.ValueNode}" />
                                <MenuItem Header="Texture Input"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.TextureInputNode}" />
                                <MenuItem Header="Linear Gradient"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.LinearGradientNode}" />
                            </MenuItem>

                            <MenuItem Header="Middle Nodes">
                                <MenuItem Header="Reroute"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.RerouteNode}"/>
                                <MenuItem Header="Perlin Noise Fractal"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.PerlinNoiseNode}"/>
                                <MenuItem Header="Perlin Noise Turbulence"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.PerlinTurbulenceNode}"/>
                                <MenuItem Header="Worley Noise"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.WorleyNoiseNode}"/>
                                <MenuItem Header="Blend"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.BlendNode}" />
                                <MenuItem Header="Threshold"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.ThresholdNode}" />
                                <MenuItem Header="Invert"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.InvertNode}" />
                                <MenuItem Header="Height To Normal"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.HeightToNormalNode}" />
                                <MenuItem Header="Alpha To Mask"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.AlphaToMaskNode}" />
                                <MenuItem Header="Apply Opacity Mask"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.ApplyOpacityMaskNode}" />
                                <MenuItem Header="Translate 2D"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.Translate2DNode}" />
                                <MenuItem Header="Scatter Texture"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.ScatterTextureNode}" />
                            </MenuItem>

                            <MenuItem Header="End Nodes">
                                <MenuItem Header="Output"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.OutputNode}"/>
                                <MenuItem Header="Material Output"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.MaterialOutputNode}" />
                                <MenuItem Header="Texture Preview"
                                          Command="{Binding CreateNodeCommand}"
                                          CommandParameter="{x:Static nodes:NodeType.TexturePreviewNode}" />
                            </MenuItem>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Clear workspace"
                                  Command="{Binding ClearWorkspaceCommand}" />
                    </ContextMenu>
                </nodify:NodifyEditor.ContextMenu>
            </nodify:NodifyEditor>
        </Grid>
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#303030"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"/>

        <TabControl Grid.Column="2"
                    Background="#202020"
                    BorderThickness="1,0,0,0"
                    BorderBrush="#383838">
            <TabItem Header="Texture Preview">
                <views:TexturePreviewView DataContext="{Binding TexturePreview}" />
            </TabItem>
            <TabItem Header="Material Preview">
                <views:MaterialPreviewView DataContext="{Binding MaterialPreview}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>