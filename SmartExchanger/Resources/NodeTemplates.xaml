                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Offset X"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                    <Slider Grid.Column="1"
                        Margin="10,0,0,0"
                        Minimum="-1"
                        Maximum="1"
                        Value="{Binding OffsetX,
                                        Mode=TwoWay,
                                        Delay=100}"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Offset Y"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                    <Slider Grid.Column="1"
                        Margin="10,0,0,0"
                        Minimum="-1"
                        Maximum="1"
                        Value="{Binding OffsetY,
                                        Mode=TwoWay,
                                        Delay=100}"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"/>
                </Grid>

                <CheckBox Margin="0,7,0,0"
                      Content="Wrap texture"
                      IsChecked="{Binding Wrap,
                                          Mode=TwoWay}"/>

                <TextBlock Margin="0,5,0,0"
                       Text="1.0 = full texture size"
                       Foreground="#777"
                       FontSize="10"/>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>



    <!-- End Nodes -->
    <DataTemplate DataType="{x:Type nodes:OutputNodeViewModel}">
        <nodify:Node Header="{Binding Title}" 
                     Input="{Binding Inputs}" 
                     Output="{Binding Outputs}"
                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">

            <nodify:Node.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" 
                              Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="Export"
                              Command="{Binding PlacementTarget.Tag.SaveRenderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" />
                </ContextMenu>
            </nodify:Node.ContextMenu>

            <nodify:Node.InputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeInput Header="{Binding Title}" 
                                      Anchor="{Binding Anchor, Mode=OneWayToSource}" 
                                      IsConnected="{Binding IsConnected}"/>
                </DataTemplate>
            </nodify:Node.InputConnectorTemplate>


            <Border Width="160"
                    Height="160"
                    Margin="8"
                    Background="#181818"
                    CornerRadius="6"
                    BorderBrush="#3F3F46"
                    BorderThickness="2"
                    ClipToBounds="True">

                <Grid>
                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           SnapsToDevicePixels="True"/>

                    <TextBlock Text="NO SIGNAL"
                               Foreground="#808080"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSignal}"
                                                Value="False">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </nodify:Node>
    </DataTemplate>
