                    <nodify:NodeOutput Header="{Binding Title}"
                                       Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                       IsConnected="{Binding IsConnected}"/>
                </DataTemplate>
            </nodify:Node.OutputConnectorTemplate>

            <StackPanel Margin="8">

                <TextBlock Text="Count"
                           Foreground="#CCCCCC"
                           Margin="0,3"/>

                <TextBox Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         MinWidth="70"/>

                <TextBlock Text="Seed"
                           Foreground="#CCCCCC"
                           Margin="0,8,0,3"/>

                <TextBox Text="{Binding Seed, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         MinWidth="70"/>

                <TextBlock Text="{Binding MinimumScale, StringFormat=Minimum Scale: {0:0.000}}"
                           Foreground="#CCCCCC"
                           Margin="0,8,0,3"/>

                <Slider Minimum="0.005"
                        Maximum="0.5"
                        Value="{Binding MinimumScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>

                <TextBlock Text="{Binding MaximumScale, StringFormat=Maximum Scale: {0:0.000}}"
                           Foreground="#CCCCCC"
                           Margin="0,8,0,3"/>

                <Slider Minimum="0.005"
                        Maximum="0.5"
                        Value="{Binding MaximumScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>

                <TextBlock Text="{Binding MinimumRotationDegrees, StringFormat=Minimum Rotation: {0:0}°}"
                           Foreground="#CCCCCC"
                           Margin="0,8,0,3"/>

                <Slider Minimum="-180"
                        Maximum="180"
                        Value="{Binding MinimumRotationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>

                <TextBlock Text="{Binding MaximumRotationDegrees, StringFormat=Maximum Rotation: {0:0}°}"
                           Foreground="#CCCCCC"
                           Margin="0,8,0,3"/>

                <Slider Minimum="-180"
                        Maximum="180"
                        Value="{Binding MaximumRotationDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>

            </StackPanel>
        </nodify:Node>
    </DataTemplate>
