    <DataTemplate DataType="{x:Type nodes:Translate2DNodeViewModel}">
        <nodify:Node Header="{Binding Title}"
                 Input="{Binding Inputs}"
                 Output="{Binding Outputs}"
                 ContextMenu="{StaticResource NodeContextMenu}"
                 Tag="{Binding DataContext,
                               RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">

            <nodify:Node.InputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeInput Header="{Binding Title}"
                                  Anchor="{Binding Anchor,
                                                   Mode=OneWayToSource}"
                                  IsConnected="{Binding IsConnected}"/>
                </DataTemplate>
            </nodify:Node.InputConnectorTemplate>

            <nodify:Node.OutputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeOutput Header="{Binding Title}"
                                   Anchor="{Binding Anchor,
                                                    Mode=OneWayToSource}"
                                   IsConnected="{Binding IsConnected}"/>
                </DataTemplate>
            </nodify:Node.OutputConnectorTemplate>

            <StackPanel Width="210"
                    Margin="8">

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Offset X"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                    <Slider Grid.Column="1"
                        Margin="10,0,0,0"
                        Minimum="-1"
                        Maximum="1"
                        Value="{Binding OffsetX, Mode=TwoWay, Delay=100}"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Offset Y"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                    <Slider Grid.Column="1"
                        Margin="10,0,0,0"
                        Minimum="-1"
                        Maximum="1"
                        Value="{Binding OffsetY, Mode=TwoWay, Delay=100}"
                        TickFrequency="0.01"
                        IsSnapToTickEnabled="True"/>
                </Grid>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Rotate"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Slider Grid.Column="1"
                            Margin="10,0,6,0"
                            Minimum="-180"
                            Maximum="180"
                            Value="{Binding RotationDegrees, Mode=TwoWay, Delay=100}"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"/>

                    <TextBlock Grid.Column="2"
                               Text="{Binding RotationDegrees,
                               StringFormat={}{0:0}°}"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <CheckBox Margin="0,7,0,0"
                      Content="Wrap texture"
                      IsChecked="{Binding Wrap, Mode=TwoWay}"/>

                <TextBlock Margin="0,5,0,0"
                       Text="1.0 = full texture size"
                       Foreground="#777"
                       FontSize="10"/>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>
    <DataTemplate DataType="{x:Type nodes:ScatterTextureNodeViewModel}">
        <nodify:Node Header="{Binding Title}"
             Input="{Binding Inputs}"
             Output="{Binding Outputs}"
             ContextMenu="{StaticResource NodeContextMenu}"
             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">

