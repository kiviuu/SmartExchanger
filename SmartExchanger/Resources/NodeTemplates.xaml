    <DataTemplate DataType="{x:Type nodes:TextureSizeNodeViewModel}">
        <nodify:Node Header="{Binding Title}" 
                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">

            <nodify:Node.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete" 
                              Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                              CommandParameter="{Binding}"/>
                </ContextMenu>
            </nodify:Node.ContextMenu>

            <StackPanel Width="160" Margin="8">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Size" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" 
                              Margin="10,0,0,0" 
                              ItemsSource="{Binding AvailableSizes}" 
                              SelectedItem="{Binding SelectedSize, Mode=TwoWay}"/>
                </Grid>
                <TextBlock Text="px (Square)" Foreground="#777" FontSize="10" Margin="60,2,0,0"/>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>
    <DataTemplate DataType="{x:Type nodes:TextureInputNodeViewModel}">
        <nodify:Node Header="{Binding Title}"
                 Input="{Binding Inputs}"
                 Output="{Binding Outputs}"
                 Tag="{Binding DataContext,
                               RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">

            <nodify:Node.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Delete"
                          Command="{Binding PlacementTarget.Tag.DeleteNodeCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding}"/>
                </ContextMenu>
            </nodify:Node.ContextMenu>

            <nodify:Node.OutputConnectorTemplate>
                <DataTemplate>
                    <nodify:NodeOutput Header="{Binding Title}"
                                   Anchor="{Binding Anchor,
                                                    Mode=OneWayToSource}"
                                   IsConnected="{Binding IsConnected}"/>
                </DataTemplate>
            </nodify:Node.OutputConnectorTemplate>

            <StackPanel Width="210"
                    Margin="8">

                <Border Padding="8"
                    Margin="0,0,0,8"
                    Background="#242424"
                    BorderBrush="#454545"
                    BorderThickness="1"
                    CornerRadius="4">

                    <StackPanel>
                        <TextBlock Text="{Binding FileName}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FilePath}"/>

                        <TextBlock Text="{Binding TextureInfo}"
                               Margin="0,3,0,0"
                               Foreground="#909090"
                               FontSize="11"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                        Height="27"
                        Content="Load..."
                        Command="{Binding LoadTextureCommand}"/>

                    <Button Grid.Column="2"
                        Height="27"
                        Content="Clear"
                        IsEnabled="{Binding HasTexture}"
                        Command="{Binding ClearTextureCommand}"/>
                </Grid>
            </StackPanel>
        </nodify:Node>
    </DataTemplate>



