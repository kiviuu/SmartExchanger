{
  "Application": {
    "Name": "Smart Exchanger",
    "Subtitle": "Procedural Texture and Material Editor",
    "Author": "Bartosz Zięba",
    "CopyrightOwner": "Bartosz Zięba",
    "SplashMinimumDisplayMilliseconds": 1500
  },

  "Rendering": {
    "DefaultTextureSize": 512,
    "OutputPreviewSize": 256,
    "TexturePreviewSize": 512,
    "MaterialPreviewSize": 512,
    "MinimumGpuCacheMb": 16,
    "MaximumGpuCacheMb": 96
  },

  "MaterialPreview": {
    "EnvironmentMapsDirectory": "Assets/EnvironmentMaps",
    "DefaultEnvironmentMap": "Cubemap_Brown_Photostudio.dds",
    "DefaultRoughness": 0.5,
    "DefaultMetallic": 0.0,
    "AmbientOcclusion": 1.0,

    "DefaultMappingMode":  "Triplanar",
    "TriplanarScale": 1.0,
    "TriplanarBlendSharpness": 4.0,
    "TriplanarNormalStrength": 1.0
  },

  "Shaders": {
    "Directory": "Shaders"
  },

  "Export": {
    "JpegQuality": 95
  }
}