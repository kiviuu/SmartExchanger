// kind=shader
uniform shader baseColorImage;
uniform shader opacityImage;

half getScalarValue(half3 color)
{
    return dot(color, half3(0.2126, 0.7152, 0.0722));
}

half4 main(float2 position)
{
    half3 baseColor = baseColorImage.eval(position).rgb;
    half opacity = clamp(
        getScalarValue(opacityImage.eval(position).rgb),
        0.0,
        1.0);

    // W SmartExchangerze przezroczystość pochodzi wyłącznie
    // z osobnego wejścia Opacity. Base Color nie steruje alfą.
    return half4(baseColor * opacity, opacity);
}
